# Optional server-side NVIDIA configuration.
# Leave NVIDIA_API_KEY empty to use deterministic prototype fallback reasoning.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Only needed when the frontend is hosted separately from FastAPI.
FRONTEND_ORIGIN=http://localhost:8000